{
  "kind": "collectionType",
  "collectionName": "parts",
  "info": {
    "singularName": "part",
    "pluralName": "parts",
    "displayName": "Part",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "purchasePrice": {
